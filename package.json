{
  "name": "editor-terminal",
  "version": "0.1.0",
  "description": "A minimal terminal emulator built with Electron and xterm.js, as a learning project",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "tsc && electron .",
    "check": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^7.0.4",
    "dompurify": "^3.4.13",
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2"
  }
}
