{
  "compilerOptions": {
    // Where source lives and where compiled JS goes
    "rootDir": "src",
    "outDir": "dist",

    // The whole project is native ES modules ("type": "module" in
    // package.json): the browser runs renderer.js via <script type="module">,
    // Electron's main process runs main.js as ESM directly. The one
    // exception is preload.cts — Electron's sandbox requires preload to be
    // CommonJS, and the .cts extension tells tsc to emit that one file as
    // .cjs while its source still uses import syntax.
    "module": "nodenext",
    "target": "es2022",

    // The renderer needs browser types (DOM); main needs Node types.
    // One config serves both — the unneeded types are just ignored.
    "lib": ["es2022", "dom"],
    "types": ["node"],

    // The whole point: maximum checking
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src"]
}
